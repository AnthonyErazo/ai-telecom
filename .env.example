# =============================================================================
# recibo-claro — configuración del servicio.
#
# NINGUNA de estas variables es obligatoria: la API arranca sin `.env`, sin
# Docker, sin PostgreSQL y sin red.  Copie este fichero a `.env` solo si quiere
# cambiar algo:   cp .env.example .env
#
#   Arranque mínimo:   make dev          (o: uvicorn apps.api.main:app --reload)
#   Comprobación:      make probar
# =============================================================================

ENTORNO=dev

# --- Almacenamiento ----------------------------------------------------------
# memoria   nunca se toca PostgreSQL, aunque DATABASE_URL esté definida.
# postgres  se exige DATABASE_URL; si no responde, se degrada avisando en el log.
# auto      (por defecto) PostgreSQL solo si DATABASE_URL trae valor.
#
# Lo único que se persiste en PostgreSQL es el índice vectorial del RAG. El
# dataset se lee de `data/sintetico/` y la bitácora de auditoría es un JSONL
# local, así que sin base de datos la API responde exactamente lo mismo: solo
# pierde la persistencia del índice entre reinicios.
MODO_ALMACENAMIENTO=auto

# Vacía a propósito. `docker compose` la inyecta apuntando al servicio `db`;
# fuera de Docker, defínala solo si tiene un PostgreSQL con pgvector a mano.
# Si la deja vacía y hay SUPABASE_DB_URL, el índice vectorial usa esa: apuntan a la
# misma base y, sin DSN, el índice degrada a memoria y vuelve a pedirle a Gemini el
# corpus entero en CADA arranque, contra una cuota de mil embeddings al día.
# DATABASE_URL=postgresql://recibo:recibo@127.0.0.1:5432/recibo
DATABASE_URL=

# --- Origen de los recibos ---------------------------------------------------
# De dónde salen los recibos que se le explican al cliente.
#
#   supabase   ← EL ORIGEN DEL PROYECTO. La tabla `cargo_facturado` con las 297 002
#              filas del dataset del Desafío 1. Exige SUPABASE_DB_URL (arriba). Las
#              cuentas son numéricas (750684421, 604511549…).
#
#   (vacío)    `data/sintetico/`, el dataset determinístico que se genera con
#              `make seed`. Es el RESPALDO para trabajar sin red y lo que usan las
#              pruebas; solo existen ahí las cuentas de guion C-DEMO-01/02/03.
#
# Viene con `supabase` puesto porque es de donde salen los recibos de verdad. Dejarlo
# vacío por defecto costó caro: la interfaz ofrecía cuentas C-DEMO que el motor no
# encontraba, el login moría con «la cuenta no existe» y parecía un fallo del chat.
#
# Sigue exigiéndose el valor explícito —no basta con tener SUPABASE_DB_URL— porque esa
# conexión la usan también el vocabulario y las FAQ, y tenerla configurada no debe
# cambiar en silencio de dónde sale la facturación que se le explica a una persona. Si
# se pide `supabase` sin DSN, el arranque falla diciendo exactamente eso; no degrada al
# dataset sintético a espaldas de nadie.
ORIGEN_RECIBOS=supabase

# --- Capa generativa ---------------------------------------------------------
# Quién REDACTA el texto que lee el cliente. Tres caminos al mismo contrato:
#   mock       ningún modelo: plantillas determinísticas, sin red, en milisegundos.
#              Es el valor por defecto del código para que la API arranque sin nada
#              configurado, y el que usan las pruebas. NO es un respaldo degradado:
#              produce exactamente las mismas cifras, porque las cifras las calcula
#              el motor, no el modelo.
#   gemini     SDK de Google, ruta directa y depurada. **Es lo que se usa en marcha.**
#   langchain  adaptador a ~14 fabricantes (OpenAI, Anthropic, Ollama local…).
#              Ver el bloque de más abajo. No se instala nada mientras no se use.
#
# Ponga `gemini` aquí junto con GEMINI_API_KEY para que responda el modelo real.
#
# CASCADA: admite varios separados por comas, en orden de preferencia.
#     LLM_MODE=gemini,langchain
# Si el primero agota cuota (429) o se le acaba el tiempo, se intenta el siguiente
# ANTES de degradar a plantilla. La red de seguridad no se quita: se retrasa. Si
# fallan todos, la plantilla determinística responde igual que siempre.
# Un proveedor sin credencial en esta instalación se salta sin consumir intento.
#
# La bitácora registra qué modelo respondió DE VERDAD, no el que se pidió.
LLM_MODE=mock                 # mock | gemini | langchain | varios separados por comas
GEMINI_API_KEY=               # vacío en la demo; NUNCA se commitea
GEMINI_MODEL=                 # verificar el id vigente en la documentación de Google
LLM_TIMEOUT_S=4
VERIFICADOR_ESTRICTO=true

# --- Conversación de voz en tiempo real (Gemini Live) ------------------------
# Es un canal separado: NO sustituye GEMINI_MODEL porque el proveedor anterior
# exige JSON estructurado y el modelo Live trabaja por WebSocket/audio.
# La API key permanece en FastAPI; POST /v1/live/token entrega al navegador un
# token efímero de un uso, válido un minuto para abrir la sesión.
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_LIVE_VOICE=Kore
GEMINI_LIVE_SESSION_MIN=30

# --- Embeddings: un trabajo DISTINTO del anterior -----------------------------
# Esto no redacta nada. Convierte los documentos del corpus (catálogo, FAQs,
# casuísticas) en vectores para poder buscarlos. Es otra decisión y otra variable:
# se puede tener el chat en Gemini y los embeddings en mock, o al revés.
#
# EMBED_MODE vacío ⇒ hereda LLM_MODE y, en su defecto, `mock` (MockEmbedder
# determinístico, sin red). Lo lee la capa de recuperación, no el modelo Ajustes.
#
# CUIDADO: cambiar de modelo de embeddings o de EMBED_DIM obliga a REINDEXAR el
# corpus entero — cada fila guarda el vector con el que se generó.
EMBED_MODE=                   # vacío | mock | gemini
GEMINI_EMBED_MODEL=
EMBED_DIM=768

# --- LLM_MODE=langchain: cualquier modelo soportado por LangChain -------------
# Adaptador sobre langchain-core (MIT), en packages/llm_layer/providers/langchain_.py.
# Es ADITIVO: `mock` sigue siendo el camino por defecto y `gemini` no cambia. El
# generador, el verificador numérico y el motor de hechos no se enteran: el adaptador
# cumple el mismo contrato ProveedorLLM (nombre + completar) y traduce los fallos a la
# misma jerarquía de errores, así que un modelo caído degrada a plantilla igual.
#
# langchain-core es una dependencia OPCIONAL:  pip install -e ".[langchain]"
# Si falta el paquete de integración, el arranque NO se rompe: se responde con la
# plantilla determinística y el log dice qué `pip install` falta.
#
# LLM_MODE=langchain
# LLM_LANGCHAIN_MODELO=openai:gpt-4o-mini   # "proveedor:modelo"; también
#                                           # google_genai:gemini-2.5-flash,
#                                           # anthropic:claude-..., ollama:llama3.1
# LLM_LANGCHAIN_PROVEEDOR=                  # solo si el modelo no lleva el prefijo
# LLM_LANGCHAIN_API_KEY=                    # vacío = la integración lee la suya
#                                           # (OPENAI_API_KEY, ANTHROPIC_API_KEY…)
# LLM_LANGCHAIN_METODO=                     # function_calling | json_schema |
#                                           # json_mode | texto   (vacío = automático)
#
# OJO con los modelos que razonan. Es el mismo aprendizaje que está escrito en
# gemini.py: los tokens de pensamiento se descuentan del MISMO presupuesto de salida,
# así que con un presupuesto corto el JSON llega TRUNCADO y el sistema degrada a
# plantilla creyendo que el modelo devolvió basura. Aquí no hay nada que razonar: los
# hechos ya vienen calculados y el modelo solo redacta.
# LLM_LANGCHAIN_MAX_TOKENS=8192             # presupuesto de salida (por defecto 8192)
# LLM_LANGCHAIN_EXTRA={"thinking_budget": 0}   # kwargs extra del constructor, en JSON.
#                                              # OpenAI: {"reasoning_effort":"minimal"}

# --- Telemetría de terceros: APAGADA. Nada sale hacia LangSmith. --------------
# langchain-core arrastra `langsmith` como dependencia transitiva. Por defecto el
# tracing está apagado, pero se declara explícito para que un `.env` heredado o una
# variable de CI no lo encienda. El interruptor real es
# `langsmith.utils.tracing_is_enabled()`, que lee estas variables y compara con "true";
# están cacheadas con lru_cache, así que se fijan ANTES de importar langchain_core.
LANGSMITH_TRACING=false
LANGSMITH_TRACING_V2=false
LANGCHAIN_TRACING=false
LANGCHAIN_TRACING_V2=false
LANGSMITH_OTEL_ENABLED=false
LANGCHAIN_CALLBACKS_BACKGROUND=false
LANGSMITH_API_KEY=
LANGCHAIN_API_KEY=
LANGSMITH_ENDPOINT=
LANGCHAIN_ENDPOINT=

# --- Reglas de negocio y determinismo ----------------------------------------
DEMO_SEED=20260804
RULES_VERSION=1.0.0

# --- Seguridad ---------------------------------------------------------------
JWT_SECRET=solo-desarrollo-cambiar

# --- Integración con los sistemas de Movistar --------------------------------
# Vacías = se lee el dataset local de DATOS_SINTETICOS. Con URL = HTTP contra
# los mocks (docker compose) o contra los sistemas reales.
BRAINYBILL_BASE_URL=
AMDOCS_BASE_URL=
DATOS_SINTETICOS=data/sintetico

# --- Gobernanza --------------------------------------------------------------
# Rutas de la bitácora encadenada y de la telemetría. Vacías = data/auditoria/
# eventos.jsonl y data/telemetria/sondas.jsonl. Sin base de datos de por medio.
AUDIT_LOG_PATH=
TELEMETRIA_PATH=

# --- Orquestación: quién conduce POST /v1/explicar ----------------------------
# grafo   (por defecto) el turno lo conduce packages/orquestacion: LangGraph con
#         checkpointer persistente. Es la vía con la que se hace la demostración.
# directo la función lineal de apps/api/routers/explicar.py, la que estaba verde
#         antes de introducir LangGraph. No importa nada de LangGraph.
#
# Las dos devuelven la MISMA respuesta y escriben la MISMA bitácora
# (tests/unit/test_grafo.py lo comprueba turno a turno). La doble vía existe por
# una razón operativa: si el grafo fallara el día de la demo se conmuta con esta
# variable, no con un despliegue. Un valor mal escrito cae a `directo`.
ORQUESTADOR=grafo

# --- Orquestación: estado de conversación persistente -------------------------
# packages/orquestacion modela el turno como un StateGraph de LangGraph (MIT) y
# guarda su estado en un SQLite indexado por conversation_id. Es lo que hace que el
# historial de turnos y la histéresis de derivación sobrevivan a un reinicio: hoy
# viven en RAM y se pierden enteros.
#
# Vacía = data/checkpoints/turnos.sqlite (data/ ya está en .gitignore: el estado de
# conversación de un cliente no se versiona). El valor especial `:memory:` desactiva
# la persistencia sin tocar el disco. Si la ruta no se puede abrir, el sistema
# DEGRADA a memoria avisando en el log; nunca deja de responder.
CHECKPOINT_PATH=

# sync (por defecto) escribe el checkpoint antes de ejecutar el paso siguiente, así
# que un turno interrumpido queda inspeccionable. async escribe en segundo plano y
# exit solo al terminar el turno.
CHECKPOINT_DURABILITY=sync

# --- Pendientes de validación con Movistar -----------------------------------
COBRO_EN_SUSPENSION=false     # POR VALIDAR con Movistar
CONVENCION_PRORRATEO=actual   # actual | 30_360   POR VALIDAR
